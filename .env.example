# API connects as a login role that is a member of app_runtime (RLS enforced)
DATABASE_URL=postgres://retail_api:retail_api@localhost:5432/retail
# Auth (password hashes, device secrets), signup and background jobs: member of app_worker
WORKER_DATABASE_URL=postgres://retail_worker:retail_worker@localhost:5432/retail
# 32+ random characters. Required when NODE_ENV=production.
JWT_SECRET=
PORT=3000
# Local file storage for dev (production: S3-compatible, London region)
FILE_STORE_DIR=./.files
# Invoice OCR via Claude. Without a key, invoices are keyed in by hand (PUT /v1/invoices/:id/extraction).
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5-5
