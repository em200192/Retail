# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 24
# Public address. Without your own domain use <server-ip-with-dashes>.sslip.io, e.g. 88-80-148-10.sslip.io
# With your own domain: add DNS A records app / api / till -> server IP, then DOMAIN=tillmate.co.uk
DOMAIN=88-80-148-10.sslip.io
ACME_EMAIL=you@example.com

PG_PASSWORD=
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
# 64 hex characters: openssl rand -hex 32
JWT_SECRET=

# Reads supplier invoices (https://console.anthropic.com). Leave empty to switch invoice reading off.
ANTHROPIC_API_KEY=
